string standalone.sms_record_attendance(string enrollment_id,string date_text,string attendance_status)
{
    if(!enrollment_id.matches("[0-9]{1,30}") || !date_text.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}") || !{"Present","Absent","Late","Excused"}.contains(attendance_status))
    {
        return {"ok":false,"error":"INVALID_ATTENDANCE_INPUT"}.toString();
    }
    day = date_text.toDate("yyyy-MM-dd");
    enrollment = zoho.crm.getRecordById("Enrollments",enrollment_id.toLong(),Map(),"sms_crm");
    if(enrollment.get("id") == null || enrollment.get("Start_Date") == null || enrollment.get("End_Date") == null)
    {
        return {"ok":false,"error":"ENROLLMENT_NOT_FOUND"}.toString();
    }
    if(day > zoho.currentdate || day < enrollment.get("Start_Date").toDate("yyyy-MM-dd") || day > enrollment.get("End_Date").toDate("yyyy-MM-dd"))
    {
        return {"ok":false,"error":"DATE_OUTSIDE_ENROLLMENT"}.toString();
    }
    sectionId = enrollment.get("Class_Section").get("id").toString();
    calendar = standalone.sms_query("select id from School_Days where Record_Key = '"+sectionId+":"+date_text+"' limit 1").toMap();
    if(calendar.get("ok") != true) { return calendar.toString(); }
    if(calendar.get("data").size() != 1)
    {
        return {"ok":false,"error":"NOT_A_SCHOOL_DAY"}.toString();
    }
    present = 0;
    eligible = 1;
    if(attendance_status == "Present" || attendance_status == "Late") { present = 1; }
    if(attendance_status == "Excused") { eligible = 0; }
    data = {"Record_Key":enrollment_id+":"+date_text,"Enrollment":{"id":enrollment_id},"Attendance_Date":date_text,"Attendance_Status":attendance_status,"Present_Units":present,"Eligible_Units":eligible};
    saved = standalone.sms_insert_once("Attendance",data.toString(),"Record_Key").toMap();
    if(saved.get("ok") != true) { return saved.toString(); }
    totals = standalone.sms_refresh_attendance(enrollment_id).toMap();
    saved.put("summary_updated",totals.get("ok"));
    return saved.toString();
}
